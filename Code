The following code is executable on Python 3.9+ or Pycharm 

import time
import itertools
import string
import tkinter as tk

# Dictionary
common_passwords = [
    "123456", "password", "12345678", "qwerty",
    "abc123", "password123", "admin", "letmein",
    "welcome", "monkey", "football", "iloveyou",
    "Test123", "Hello123"
]

def crack_password():
    target_password = entry.get()
    result_label.config(text="Starting attack...", fg="blue")
    attempts_label.config(text="Attempts: 0")
    root.update()

    start_time = time.time()
    attempt_count = 0

    # -------- Dictionary Attack --------
    status_label.config(text="🔍 Dictionary Attack...")
    root.update()

    for password in common_passwords:
        attempt_count += 1

        if attempt_count % 2 == 0:
            attempts_label.config(text=f"Attempts: {attempt_count}")
            root.update()

        if password == target_password:
            end_time = time.time()
            result_label.config(
                text=f"✅ Cracked!\nPassword: {password}\nMethod: Dictionary\nTime: {round(end_time - start_time, 4)}s",
                fg="green"
            )
            return

    # -------- Brute Force Attack --------
    status_label.config(text="⚡ Brute Force Attack...")
    root.update()

    chars = string.ascii_lowercase + string.ascii_uppercase + string.digits + "!@#$%_.()"
    max_length = 3

    for length in range(1, max_length + 1):
        status_label.config(text=f"⚡ Brute Force (length {length})")
        root.update()

        for guess in itertools.product(chars, repeat=length):
            attempt = ''.join(guess)
            attempt_count += 1

            # Update GUI every 500 attempts
            if attempt_count % 500 == 0:
                attempts_label.config(text=f"Attempts: {attempt_count}")
                result_label.config(text=f"Trying: {attempt}", fg="orange")
                root.update()

            if attempt == target_password:
                end_time = time.time()
                result_label.config(
                    text=f"✅ Cracked!\nPassword: {attempt}\nMethod: Brute Force\nTime: {round(end_time - start_time, 4)}s",
                    fg="green"
                )
                return

    result_label.config(text="❌ Not cracked", fg="red")


# -------- GUI --------
root = tk.Tk()
root.title("Cybersecurity Password Cracker Simulator")
root.geometry("450x300")

tk.Label(root, text="Enter password to crack:", font=("Arial", 12)).pack(pady=5)

entry = tk.Entry(root, show="*", width=30, font=("Arial", 12))
entry.pack(pady=5)

tk.Button(root, text="Start Attack", command=crack_password, font=("Arial", 12)).pack(pady=10)

status_label = tk.Label(root, text="", font=("Arial", 10))
status_label.pack()

attempts_label = tk.Label(root, text="Attempts: 0", font=("Arial", 10))
attempts_label.pack()

result_label = tk.Label(root, text="", font=("Arial", 12))
result_label.pack(pady=10)

root.mainloop()
